# Copy this file to .env.local and fill in the project's public connection values.
# These settings will be used by the upcoming Supabase frontend integration.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Never put a database password, secret key, or service_role key in a VITE_ variable.
